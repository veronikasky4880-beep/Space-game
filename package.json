{
  "name": "dogfight",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
    "scripts": {
    "typecheck": "tsc --noEmit -p client && tsc --noEmit -p server && tsc --noEmit -p shared",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "loadtest": "node --env-file=server/.env server/src/loadtest.js"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "vitest": "^5.1.0"
  }
}
